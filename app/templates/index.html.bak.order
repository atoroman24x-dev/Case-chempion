<!DOCTYPE html>
<html lang="ru" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Где моё лекарство</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <a class="skip-link" href="#content">Перейти к содержимому</a>
  <header class="topbar">
    <div>
      <div class="brand-mark">PL</div>
      <div>
        <p class="eyebrow">Пульс-АйТим</p>
        <h1>Где моё лекарство?</h1>
      </div>
    </div>
    <button class="theme-toggle" data-theme-toggle aria-label="Переключить тему">◐</button>
  </header>
  <main id="content" class="layout">
    <section class="hero-card">
      <div>
        <p class="eyebrow">Отслеживание упаковок препаратов</p>
        <h2>Контроль движения серий, складов и клиентских отгрузок</h2>
        <p class="hero-text">Поиск по коду упаковки и серии, история перемещений, регистрация новых событий и сохранение данных в общей тестовой базе.</p>
      </div>
      <div class="metric-grid">
        <article class="metric-card"><span>Упаковок</span><strong>{{ metrics.packages }}</strong></article>
        <article class="metric-card"><span>Событий</span><strong>{{ metrics.events }}</strong></article>
        <article class="metric-card"><span>Серий</span><strong>{{ metrics.batches }}</strong></article>
        <article class="metric-card warning"><span>Без обновлений</span><strong>{{ metrics.stale }}</strong></article>
      </div>
    </section>

    <section class="panel filters-panel">
      <form method="get" class="search-form">
        <div class="field"><label for="code">Поиск упаковки</label><input id="code" name="code" value="{{ search_code }}" placeholder="PACK-00017"></div>
        <div class="field"><label for="batch">Поиск серии</label><input id="batch" name="batch" value="{{ search_batch }}" placeholder="BATCH-AX2401"></div>
        <div class="actions"><button class="btn btn-primary" type="submit">Найти</button><a class="btn btn-ghost" href="/">Сбросить</a></div>
      </form>
    </section>

    <section class="content-grid">
      <div class="left-column">
        <section class="panel">
          <div class="section-title-row"><h3>Результаты поиска</h3><span class="count-pill">{{ packages|length }}</span></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Код</th><th>Серия</th><th>Препарат</th><th>Последнее место</th><th>Статус</th><th>Подтверждено</th></tr></thead>
              <tbody>
                {% for item in packages %}
                <tr class="package-row" data-package-code="{{ item.package_code }}">
                  <td>{{ item.package_code }}</td>
                  <td>{{ item.batch_number }}</td>
                  <td>{{ item.medicine_name }}</td>
                  <td>{{ item.last_location }}</td>
                  <td>
                    <span class="status-chip {% if item.stale %}status-delayed{% endif %}">{{ item.status_label }}</span>
                    {% if item.suspicious %}<span class="mini-flag">быстрое перемещение</span>{% endif %}
                  </td>
                  <td>{{ item.last_event_time or '—' }}</td>
                </tr>
                {% else %}
                <tr><td colspan="6" class="empty-cell">Ничего не найдено</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </section>

        <section class="panel">
          <div class="section-title-row"><h3>Серии по складам и статусам</h3></div>
          <div class="batch-grid">
            {% for batch, block in grouped_batches.items() %}
            <article class="batch-card">
              <div class="batch-card-head">
                <div><p class="eyebrow">Серия</p><h4>{{ batch }}</h4></div>
                <span class="count-pill">{{ block.items|length }}</span>
              </div>
              <div class="batch-columns">
                <div>
                  <p class="mini-title">Склады / точки</p>
                  <ul>
                    {% for location, qty in block.warehouses.items() %}
                    <li><span>{{ location }}</span><strong>{{ qty }}</strong></li>
                    {% endfor %}
                  </ul>
                </div>
                <div>
                  <p class="mini-title">Статусы</p>
                  <ul>
                    {% for status, qty in block.statuses.items() %}
                    <li><span>{{ status }}</span><strong>{{ qty }}</strong></li>
                    {% endfor %}
                  </ul>
                </div>
              </div>
            </article>
            {% endfor %}
          </div>
        </section>
      </div>

      <aside class="right-column">
        <section class="panel detail-panel">
          <div class="section-title-row"><h3>История упаковки</h3><span id="detail-code" class="count-pill">выбери строку</span></div>
          <div id="detail-meta" class="detail-meta">Нажми на упаковку в таблице, чтобы посмотреть маршрут и события.</div>
          <div id="detail-warning"></div>
          <div id="timeline" class="timeline"></div>
        </section>

        <section class="panel form-panel">
          <h3>Добавить событие</h3>
          <form method="post" action="/events" class="stack-form">
            <div class="field"><label>Код упаковки</label><input name="package_code" placeholder="PACK-00017" required></div>
            <div class="field"><label>Тип события</label><select name="event_type">{% for key, label in event_types.items() %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></div>
            <div class="field"><label>Статус</label><select name="status">{% for key, label in statuses.items() if key != 'delayed' %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></div>
            <div class="field"><label>Локация</label><input name="location" placeholder="Склад Ростов" required></div>
            <div class="field"><label>Контрагент</label><input name="counterparty" placeholder="Аптека Вита / Склад Москва"></div>
            <div class="field"><label>Дата и время</label><input type="datetime-local" name="event_time" required></div>
            <div class="field"><label>Номер заказа</label><input name="order_number" placeholder="SHIP-1042"></div>
            <div class="field"><label>Комментарий</label><textarea name="note" rows="3" placeholder="Подтверждение передачи"></textarea></div>
            <button class="btn btn-primary" type="submit">Сохранить событие</button>
          </form>
        </section>

        <section class="panel form-panel">
          <h3>Добавить упаковку</h3>
          <form method="post" action="/packages" class="stack-form">
            <div class="field"><label>Код упаковки</label><input name="package_code" placeholder="PACK-90001" required></div>
            <div class="field"><label>Серия</label><input name="batch_number" placeholder="BATCH-NEW2405" required></div>
            <div class="field"><label>Препарат</label><input name="medicine_name" placeholder="Кардиолекс" required></div>
            <div class="field"><label>Дата производства / приёмки</label><input type="datetime-local" name="produced_at" required></div>
            <div class="field"><label>Первое местонахождение</label><select name="first_location">{% for warehouse in warehouses %}<option value="{{ warehouse }}">{{ warehouse }}</option>{% endfor %}</select></div>
            <div class="field"><label>Комментарий</label><textarea name="note" rows="3" placeholder="Новая упаковка для проверки"></textarea></div>
            <button class="btn btn-primary" type="submit">Создать упаковку</button>
          </form>
        </section>
      </aside>
    </section>
  </main>
  <script src="/static/app.js" defer></script>
</body>
</html>
