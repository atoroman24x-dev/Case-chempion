:root, [data-theme="light"] { --bg:#f4f7fb; --surface:#ffffff; --surface-2:#f8fbff; --line:#d7e2f1; --text:#142033; --muted:#617089; --primary:#1c64f2; --primary-2:#123fa2; --success:#0f9f6e; --warn:#d97706; --danger:#c2410c; --shadow:0 18px 50px rgba(13,29,56,.08); }
[data-theme="dark"] { --bg:#0d1523; --surface:#121d30; --surface-2:#17243a; --line:#25324d; --text:#eaf1ff; --muted:#9aa8c0; --primary:#6ea8ff; --primary-2:#8bb9ff; --success:#27c18e; --warn:#ffb547; --danger:#ff8e64; --shadow:0 18px 50px rgba(0,0,0,.3); }
*{box-sizing:border-box}
html,body{margin:0;padding:0;font-family:'Manrope',sans-serif;background:linear-gradient(180deg,var(--bg),#edf3fb 45%,var(--bg));color:var(--text)}
[data-theme="dark"] body{background:linear-gradient(180deg,#0b1320,#0d1523 45%,#08101b)}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit}
.skip-link{position:absolute;left:-9999px}
.skip-link:focus{left:16px;top:16px;background:var(--surface);padding:10px 14px;border-radius:10px;z-index:20}
.topbar{display:flex;justify-content:space-between;align-items:center;padding:28px 40px 12px}
.topbar>div{display:flex;gap:16px;align-items:center}
.brand-mark{width:52px;height:52px;border-radius:18px;display:grid;place-items:center;color:#fff;font-weight:800;background:linear-gradient(135deg,var(--primary),var(--primary-2));box-shadow:var(--shadow)}
.eyebrow{margin:0 0 6px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;font-size:12px}
h1,h2,h3,h4,p{margin:0}
h1{font-size:28px}
h2{font-size:34px;max-width:700px;line-height:1.08}
h3{font-size:20px}
.layout{padding:20px 40px 40px;display:grid;gap:20px}
.hero-card,.panel{background:color-mix(in srgb,var(--surface) 90%,transparent);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow);backdrop-filter:blur(14px)}
.hero-card{padding:28px;display:grid;gap:24px;grid-template-columns:1.4fr 1fr}
.hero-text{margin-top:12px;max-width:64ch;color:var(--muted);line-height:1.6}
.metric-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.metric-card{border-radius:20px;padding:18px;background:var(--surface-2);border:1px solid var(--line);display:flex;flex-direction:column;gap:10px}
.metric-card span{color:var(--muted);font-size:13px}
.metric-card strong{font-size:30px}
.metric-card.warning strong{color:var(--warn)}
.filters-panel{padding:20px 24px}
.search-form,.stack-form{display:grid;gap:14px}
.search-form{grid-template-columns:1fr 1fr auto;align-items:end}
.field{display:grid;gap:8px}
.field label{font-size:13px;color:var(--muted)}
input,select,textarea{width:100%;border:1px solid var(--line);border-radius:14px;padding:13px 14px;background:var(--surface);color:var(--text)}
input:focus,select:focus,textarea:focus{outline:2px solid color-mix(in srgb,var(--primary) 55%,white);border-color:var(--primary)}
.actions{display:flex;gap:10px}
.btn{border-radius:14px;padding:13px 18px;border:1px solid var(--line);display:inline-flex;align-items:center;justify-content:center;font-weight:700;cursor:pointer;min-height:48px}
.btn-primary{background:linear-gradient(135deg,var(--primary),var(--primary-2));color:#fff;border:none}
.btn-ghost{background:var(--surface)}
.content-grid{display:grid;grid-template-columns:1.55fr .95fr;gap:20px;align-items:start}
.left-column,.right-column{display:grid;gap:20px}
.panel{padding:22px}
.section-title-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;gap:10px}
.count-pill,.mini-flag,.status-chip{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:6px 10px;font-size:12px}
.count-pill{background:var(--surface-2);border:1px solid var(--line);color:var(--muted)}
.table-wrap{overflow:auto}
table{width:100%;border-collapse:collapse;min-width:840px}
th,td{text-align:left;padding:14px 10px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
.package-row{cursor:pointer;transition:.2s ease}
.package-row:hover{background:var(--surface-2)}
.status-chip{background:color-mix(in srgb,var(--success) 14%,white);color:var(--success);margin-right:8px}
.status-delayed{background:color-mix(in srgb,var(--warn) 18%,white);color:var(--warn)}
.mini-flag{background:color-mix(in srgb,var(--danger) 15%,white);color:var(--danger);margin-top:8px}
.empty-cell{text-align:center;color:var(--muted);padding:24px}
.batch-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.batch-card{border:1px solid var(--line);background:var(--surface-2);border-radius:20px;padding:18px;display:grid;gap:14px}
.batch-card-head{display:flex;align-items:start;justify-content:space-between;gap:12px}
.batch-columns{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.batch-columns ul{list-style:none;padding:0;margin:0;display:grid;gap:10px}
.batch-columns li{display:flex;justify-content:space-between;gap:10px;color:var(--muted)}
.mini-title{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:10px}
.detail-meta{color:var(--muted);margin-bottom:14px}
.timeline{display:grid;gap:12px}
.timeline-item{padding:14px;border-radius:18px;border:1px solid var(--line);background:var(--surface-2);display:grid;gap:8px}
.timeline-head{display:flex;justify-content:space-between;gap:12px}
.timeline-head strong{font-size:15px}
.timeline-meta{color:var(--muted);font-size:13px}
.warning-box{margin:0 0 14px;padding:12px 14px;border-radius:14px;border:1px solid color-mix(in srgb,var(--warn) 35%,white);background:color-mix(in srgb,var(--warn) 12%,white);color:var(--warn)}
.theme-toggle{width:48px;height:48px;border-radius:16px;border:1px solid var(--line);background:var(--surface);color:var(--text);cursor:pointer}
@media (max-width:1120px){.hero-card,.content-grid{grid-template-columns:1fr}}
@media (max-width:760px){.topbar,.layout{padding-left:16px;padding-right:16px}.search-form,.batch-grid,.batch-columns,.metric-grid{grid-template-columns:1fr}h1{font-size:24px}h2{font-size:28px}.panel,.hero-card{padding:18px;border-radius:20px}}
